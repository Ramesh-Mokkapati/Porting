IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About PortAssist"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
ICON            IDR_MAINFRAME, IDC_STATIC, 11, 17, 20, 20
LTEXT           "PortAssist  - The Transformer\n\tVersion 1.0", IDC_STATIC, 40, 10, 119, 24, SS_NOPREFIX
LTEXT           "Copyright (C) 2017", IDC_STATIC, 40, 34, 119, 8
DEFPUSHBUTTON   "OK", IDOK, 178, 7, 50, 14, WS_GROUP
END

IDD_PORTASSIST_DIALOG DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "PortAssist - The Transformer"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
DEFPUSHBUTTON   "OK", IDOK, 213, 179, 50, 14
PUSHBUTTON      "Cancel", IDCANCEL, 263, 179, 50, 14
CONTROL         "", IDC_PORTING_TAB, "SysTabControl32", WS_TABSTOP, 18, 11, 261, 34
PUSHBUTTON      "...", IDC_SELECT_FOLDER, 258, 57, 21, 14
EDITTEXT        IDC_FOLDER_NAME, 65, 58, 181, 14, ES_AUTOHSCROLL | ES_READONLY
LTEXT           "Select Folder: ", IDC_STATIC, 17, 61, 44, 8
LTEXT           "File Patterns: ", IDC_STATIC, 18, 88, 41, 8
COMBOBOX        IDC_FILE_PATTERNS, 65, 87, 182, 30, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
GROUPBOX        "File Save options", IDC_STATIC, 18, 112, 260, 40
CONTROL         "Save Backup", IDC_SAVE_BACKUP, "Button", BS_AUTORADIOBUTTON, 38, 129, 57, 10
CONTROL         "Overwrite", IDC_OVERWRITE, "Button", BS_AUTORADIOBUTTON, 118, 130, 44, 10
END


